#!/bin/sh
set -e

if [ ! -d binary ]; then
    exit 0
fi

INITRD=$(find binary -name "initrd.img-*" -type f | head -1)
if [ -z "$INITRD" ]; then
    exit 0
fi

TMPDIR=$(mktemp -d)
trap "rm -rf $TMPDIR" EXIT

# Extract initrd
cd "$TMPDIR"
cpio -idmv < "$INITRD" 2>/dev/null || {
    # Might be compressed
    zcat "$INITRD" | cpio -idmv 2>/dev/null || {
        echo "Failed to extract initrd" >&2
        exit 1
    }
}

# Find live-boot scripts in the binary tree
LIVE_BOOT_DIR=$(find binary -path "*/usr/lib/live/boot" -type d | head -1)
if [ -z "$LIVE_BOOT_DIR" ]; then
    exit 0
fi

# Copy live-boot scripts into initrd
mkdir -p "$TMPDIR/usr/lib/live"
cp -r "$LIVE_BOOT_DIR" "$TMPDIR/usr/lib/live/"

# Also copy live-boot binary
LIVE_BOOT_BIN=$(find binary -path "*/usr/bin/live-boot" -type f | head -1)
if [ -n "$LIVE_BOOT_BIN" ]; then
    mkdir -p "$TMPDIR/usr/bin"
    cp "$LIVE_BOOT_BIN" "$TMPDIR/usr/bin/"
fi

# Repack initrd
cd "$TMPDIR"
find . -print0 | cpio --null -ov -H newc 2>/dev/null > "$INITRD.new" || {
    find . | cpio -o -H newc > "$INITRD.new" 2>/dev/null || {
        echo "Failed to repack initrd" >&2
        exit 1
    }
}

mv "$INITRD.new" "$INITRD"
echo "Added live-boot scripts to $INITRD" >&2
