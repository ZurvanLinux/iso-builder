#!/bin/sh
set -e

# Wrap modprobe so it never fails inside the build chroot.
# Many package postinst scripts call modprobe, which fails in a container
# that lacks kernel modules. This diversion ensures those calls are harmless.

MODPROBE_REAL=/sbin/modprobe.real

if [ ! -f "${MODPROBE_REAL}" ]; then
    if [ -x /sbin/modprobe ]; then
        dpkg-divert --add --rename --divert "${MODPROBE_REAL}" /sbin/modprobe
    fi
fi

cat > /sbin/modprobe << '__MODPROBE_WRAPPER_EOF__'
#!/bin/sh
# Build-time modprobe stub: try real binary, never fail.
if [ -x /sbin/modprobe.real ]; then
    /sbin/modprobe.real "$@" 2>/dev/null || exit 0
fi
exit 0
__MODPROBE_WRAPPER_EOF__

chmod +x /sbin/modprobe
