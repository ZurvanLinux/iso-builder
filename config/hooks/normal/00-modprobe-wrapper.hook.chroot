#!/bin/sh
set -e

# Create a modprobe wrapper that never fails during build/chroot.
# This prevents live-build failures due to missing modules in the chroot.

if [ ! -f /sbin/modprobe.real ]; then
    if [ -x /sbin/modprobe ]; then
        dpkg-divert --add --rename --divert /sbin/modprobe.real /sbin/modprobe
    fi
fi

cat > /sbin/modprobe << '__MODPROBE_WRAPPER_EOF__'
#!/bin/sh
# Always succeed in build/chroot environments
if [ -x /sbin/modprobe.real ]; then
    /sbin/modprobe.real "$@" 2>/dev/null || exit 0
fi
exit 0
__MODPROBE_WRAPPER_EOF__

chmod +x /sbin/modprobe
