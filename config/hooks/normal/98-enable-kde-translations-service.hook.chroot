#!/bin/sh
set -e

SVC=zurvan-install-kde-translations.service
TARGET_WANT=/etc/systemd/system/graphical.target.wants

if [ ! -f "/etc/systemd/system/${SVC}" ]; then
    echo "error: ${SVC} not found" >&2
    exit 1
fi

mkdir -p "${TARGET_WANT}"
ln -sf "/etc/systemd/system/${SVC}" "${TARGET_WANT}/${SVC}"