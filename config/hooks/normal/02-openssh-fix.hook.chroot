#!/bin/sh
set -e

# Enable SSH for the live ISO session. The live user 'user' gets a known
# password 'zurvan' so users can SSH in immediately. This is intentional:
# - Live ISOs are ephemeral and not intended for production use
# - No SSH keys are pre-configured for new users
# - Calamares installer (if used) should prompt for a real password
# The live SSH config is in a drop-in so the installed system's sshd_config
# remains untouched.

systemctl enable ssh.service 2>/dev/null || true

if id "user" >/dev/null 2>&1; then
    echo "user:zurvan" | chpasswd || true
fi

if [ -d /etc/ssh/sshd_config.d ]; then
    cat > /etc/ssh/sshd_config.d/99-zurvan-live.conf << 'EOF'
# Zurvan live ISO SSH defaults — password auth enabled for live session.
# Calamares installer should remove or override this on the installed system.
PasswordAuthentication yes
KbdInteractiveAuthentication yes
AcceptEnv LANG LC_*
EOF
fi

exit 0