[Unit]
Description=Zurvan Linux first-boot Flathub app installer
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/zurvan/flathub-installed

[Service]
Type=oneshot
ExecStartPre=/bin/mkdir -p /var/lib/zurvan
ExecStartPre=/bin/touch /var/lib/zurvan/flathub-installed
ExecStart=/usr/local/bin/zurvan-flathub-install.sh
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=graphical.target
