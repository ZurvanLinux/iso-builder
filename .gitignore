# live-build: generated control files (regenerated from auto/config each build)
config/bootstrap
config/binary
config/common
config/source

# live-build: build stages and caches
chroot/
binary/
.build/
.cache/
!config/hooks/binary/

# generated arch-conditional package lists (created by scripts/gen-arch-packages.sh)
config/package-lists/kernel-*.list.chroot
config/package-lists/bootloaders-*.list.chroot

# cloned zurvan-config (fetched at build time)
zurvan-config/

# generated ISO metadata (written by apply-zurvan-config.sh, sourced by auto/config)
.zurvan-env

# generated zurvan config (copied from zurvan-config by apply-zurvan-config.sh)
config/includes.chroot/usr/share/zurvan/config/

# generated ISO images and metadata
*.iso
*.iso.zsync
*.contents
*.packages
*.file-list*

# build output and logs
scripts/out/
scripts/lb-build-*.log
*.log

# Python bytecode caches
__pycache__/
*.py[cod]
