# live-build: generated control files (regenerated from auto/config each build)
config/bootstrap
config/binary
config/common
config/source

# live-build: build stages and caches
chroot/
binary/
.build/
.cache/
!config/hooks/binary/

# generated arch-conditional package lists (created by scripts/gen-arch-packages.sh)
config/package-lists/kernel-*.list.chroot
config/package-lists/bootloaders-*.list.chroot

# generated ISO images and metadata
*.iso
*.iso.zsync
*.contents
*.packages
*.file-list*

# build output and logs
scripts/out/
scripts/lb-build-*.log
*.log
