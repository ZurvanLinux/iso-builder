# =============================================================================
# build.env — Single source of truth for Zurvan ISO build configuration
# =============================================================================
#
# Every script (auto/config, build-iso-multipass.sh, CI) sources this file.
# To bump to a new Debian release, change the values here and nothing else.
#
# Override any value by exporting it before running build scripts:
#   export DEBIAN_CODENAME=forchy && make build
#
# ── Debian distribution ──────────────────────────────────────────────────────
DEBIAN_CODENAME="${DEBIAN_CODENAME:-trixie}"

# ── Pinned container images (reproducible builds) ────────────────────────────
# Resolve new digests after bumping DEBIAN_CODENAME:
#   docker pull --platform linux/amd64 debian:$DEBIAN_CODENAME
#   docker pull --platform linux/arm64 debian:$DEBIAN_CODENAME
DEBIAN_IMAGE_AMD64="${DEBIAN_IMAGE_AMD64:-debian:trixie@sha256:d63a99144861e4e460196ed93d07777490cbeab53ca660c434f2a589a6c50ea3}"
DEBIAN_IMAGE_ARM64="${DEBIAN_IMAGE_ARM64:-debian:trixie@sha256:8ac748152418b19ff289badbf878c42561c5b0cd922ade5fe4fa37cf0769b521}"

# ── APT mirrors ──────────────────────────────────────────────────────────────
MIRROR_MAIN="${MIRROR_MAIN:-https://deb.debian.org/debian}"
MIRROR_SECURITY="${MIRROR_SECURITY:-https://deb.debian.org/debian-security}"

# ── Archive areas ────────────────────────────────────────────────────────────
ARCHIVE_AREAS="${ARCHIVE_AREAS:-main contrib non-free non-free-firmware}"

# ── Target architecture (amd64 or arm64) ─────────────────────────────────────
ARCH="${ARCH:-arm64}"

# ── ISO metadata ─────────────────────────────────────────────────────────────
# ISO_* metadata now comes from zurvan-config/iso-metadata
# (applied by apply-zurvan-config.sh, sourced from .zurvan-env)
# Only ISO_PREPARER stays here (pipeline-specific, not Zurvan identity)
ISO_PREPARER="${ISO_PREPARER:-Zurvan Linux live-build pipeline (iso-builder)}"

# ── Zurvan config repository ─────────────────────────────────────────────────
ZURVAN_CONFIG_REPO="${ZURVAN_CONFIG_REPO:-ZurvanLinux/zurvan-config}"
ZURVAN_CONFIG_REF="${ZURVAN_CONFIG_REF:-f6f1a83}"

# ── live-build options ───────────────────────────────────────────────────────
BINARY_IMAGES="${BINARY_IMAGES:-iso-hybrid}"
APT_RECOMMENDS="${APT_RECOMMENDS:-true}"
UPDATES="${UPDATES:-true}"
BACKPORTS="${BACKPORTS:-false}"
SECURITY="${SECURITY:-true}"
MEMTEST="${MEMTEST:-none}"
CHECKSUMS="${CHECKSUMS:-sha256}"