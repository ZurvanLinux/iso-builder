#!/bin/sh
set -e

# Source centralized build configuration (single source of truth).
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../build.env
. "${SCRIPT_DIR}/build.env"

# Source generated ISO metadata from zurvan-config (if available)
[ -f "${SCRIPT_DIR}/.zurvan-env" ] && . "${SCRIPT_DIR}/.zurvan-env"

ARCH="${1:-${ARCH:-amd64}}"

lb config noauto \
    --distribution "${DEBIAN_CODENAME}" \
    --architecture "${ARCH}" \
    --archive-areas "${ARCHIVE_AREAS}" \
    --parent-archive-areas "${ARCHIVE_AREAS}" \
    --binary-images "${BINARY_IMAGES}" \
    --debian-installer none \
    --updates "${UPDATES}" \
    --backports "${BACKPORTS}" \
    --security "${SECURITY}" \
    --apt-recommends "${APT_RECOMMENDS}" \
    --apt-source-archives false \
    --memtest "${MEMTEST}" \
    --checksums "${CHECKSUMS}" \
    --mirror-bootstrap             "${MIRROR_MAIN}" \
    --mirror-binary                "${MIRROR_MAIN}" \
    --mirror-chroot-security       "${MIRROR_SECURITY}" \
    --mirror-binary-security       "${MIRROR_SECURITY}" \
    --parent-mirror-bootstrap      "${MIRROR_MAIN}" \
    --parent-mirror-binary         "${MIRROR_MAIN}" \
    --parent-mirror-chroot-security    "${MIRROR_SECURITY}" \
    --parent-mirror-binary-security    "${MIRROR_SECURITY}" \
    --iso-application "${ISO_APPLICATION:-Zurvan Linux}" \
    --iso-publisher   "${ISO_PUBLISHER:-Zurvan Linux - https://zurvanlinux.org}" \
    --iso-preparer    "${ISO_PREPARER}" \
    --iso-volume      "${ISO_VOLUME:-Zurvan Linux}" \
    "${@}"
